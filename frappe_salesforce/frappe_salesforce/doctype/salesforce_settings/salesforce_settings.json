  {"fieldname": "max_calls_per_day", "fieldtype": "Int", "label": "Max API Calls per Day", "default": "50000", "description": "App-level daily budget across all ticks. Independent of and stricter than the Salesforce org quota."},
  {"fieldname": "preflight_threshold", "fieldtype": "Percent", "label": "Preflight Skip Threshold", "default": "80", "description": "If last-known Salesforce API usage is at or above this percentage and was recorded within the last 5 minutes, the next tick is skipped without making any API call."},
