  {"fieldname": "username", "fieldtype": "Data", "label": "Integration Username", "description": "The Salesforce Username of the integration user (not necessarily their email). Must be pre-authorized on the External Client App."},
  {"fieldname": "private_key", "fieldtype": "Password", "label": "RSA Private Key (PEM)", "description": "The private key whose matching X.509 certificate is uploaded to the External Client App's 'Digital Signatures' field. Paste the full PEM including BEGIN/END lines."},
